<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE hibernate-configuration PUBLIC
        "-//Hibernate/Hibernate Configuration DTD 3.0//EN"
        "http://hibernate.sourceforge.net/hibernate-configuration-3.0.dtd">
<!-- Технология hibernate - главный файл конфигурации - аналог интерфейса Constants технологии Jdbc -->
<hibernate-configuration>
    <session-factory>

        <property name="hibernate.connection.driver_class">org.postgresql.Driver</property>
        <!-- URL базы данных: протокол : тип_бд // хост : порт / имя_базы -->
        <property name="hibernate.connection.url">jdbc:postgresql://localhost:5432/h_w_03_Houses</property>
        <property name="hibernate.connection.username">postgres</property>
        <property name="hibernate.connection.password">qwerty007</property>
        <!--Ссылка на второй файл конфигурации - для подгрузки его здесь-->
        <mapping resource="House.mapping.xml"/>

    </session-factory>
</hibernate-configuration>
